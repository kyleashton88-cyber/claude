// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Draft – not published
// Crypto Grid Strategy (Neutral / Long / Short) – risk-controlled research version for Stewart Crown.
// Educational use only. Backtest output is historical simulation and says nothing certain about future results.
// Key design choices (see CHANGES.md):
//  - Orders are decided on confirmed bars only and fill on the NEXT bar open (process_orders_on_close = false).
//  - The grid range is frozen when built and only rebuilt after invalidation, so levels do not drift every bar.
//  - No request.security() calls -> no lookahead repainting in this script.
//@version=6
strategy("Crypto Grid Strategy v2 (Neutral/Long/Short) – Draft",
     shorttitle = "GridV2", overlay = true,
     pyramiding = 20,
     initial_capital = 10000, currency = currency.USD,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 5,
     commission_type = strategy.commission.percent, commission_value = 0.055,
     slippage = 2,
     process_orders_on_close = false, calc_on_every_tick = false, calc_on_order_fills = false,
     margin_long = 100, margin_short = 100,
     max_lines_count = 100, max_labels_count = 50)

// ───────── Constants / groups ─────────
int    MAX_LEVELS = 40
string G_MODE  = "Mode"
string G_RANGE = "Grid range"
string G_REG   = "Regime filter"
string G_RISK  = "Risk"
string G_ALERT = "Webhook alerts"
string G_VIS   = "Display"

// ───────── Inputs (defaults chosen for 1h crypto perps) ─────────
string modeIn      = input.string("Neutral", "Grid mode", options = ["Neutral", "Long", "Short"], group = G_MODE, tooltip = "Neutral: longs below mid, shorts above mid, only in ranging regime. Long: buy dips on levels, only while price is above the trend EMA. Short: mirror of Long.")
string rangeSrcIn  = input.string("Donchian", "Range method", options = ["ATR", "Donchian", "Percentile"], group = G_RANGE)
int    rangeLenIn  = input.int(100, "Range lookback (bars)", minval = 10, maxval = 1000, group = G_RANGE)
float  atrMultIn   = input.float(3.0, "ATR multiplier (ATR method)", minval = 0.5, step = 0.25, group = G_RANGE)
float  pctHiIn     = input.float(90.0, "Upper percentile (Percentile method)", minval = 51, maxval = 100, group = G_RANGE)
float  pctLoIn     = input.float(10.0, "Lower percentile (Percentile method)", minval = 0, maxval = 49, group = G_RANGE)
string spacingIn   = input.string("Geometric", "Spacing", options = ["Arithmetic", "Geometric"], group = G_RANGE)
int    gridCountIn = input.int(10, "Grid lines (incl. edges)", minval = 3, maxval = MAX_LEVELS, group = G_RANGE)
float  minStepPctIn = input.float(0.6, "Min step % (fee floor)", minval = 0.05, step = 0.05, group = G_RANGE, tooltip = "Grid is not built if the step is smaller than this. Round-trip taker cost is about 0.11% plus slippage, so keep this well above that.")
int    atrLenIn    = input.int(14, "ATR length", minval = 1, group = G_RANGE)

bool   useRegimeIn = input.bool(true, "Use regime filter", group = G_REG)
int    adxLenIn    = input.int(14, "ADX length", minval = 1, group = G_REG)
float  adxMaxIn    = input.float(22.0, "ADX max for 'ranging'", minval = 5, group = G_REG)
int    bbLenIn     = input.int(20, "BB length", minval = 2, group = G_REG)
float  bbwMaxIn    = input.float(8.0, "BB width % max for 'ranging'", minval = 0.5, step = 0.5, group = G_REG)
int    emaLenIn    = input.int(200, "Trend EMA length", minval = 10, group = G_REG)

float  qtyPctIn    = input.float(5.0, "Equity % per grid order", minval = 0.1, maxval = 50, step = 0.1, group = G_RISK)
int    maxOpenIn   = input.int(6, "Max open grid levels", minval = 1, maxval = 20, group = G_RISK, tooltip = "Must be <= pyramiding (20) in strategy().")
float  stopAtrIn   = input.float(1.0, "Range-break stop: ATRs beyond edge", minval = 0.0, step = 0.25, group = G_RISK)
bool   tpEdgeIn    = input.bool(true, "Close all at opposite range edge", group = G_RISK)
int    cooldownIn  = input.int(12, "Cooldown bars after invalidation", minval = 0, group = G_RISK)

bool   alertsOnIn  = input.bool(true, "Send alert() webhooks", group = G_ALERT)
string secretIn    = input.string("CHANGE_ME", "Webhook secret (placeholder)", group = G_ALERT)
bool   showLinesIn = input.bool(true, "Show grid lines", group = G_VIS)
bool   showTableIn = input.bool(true, "Show status table", group = G_VIS)

// ───────── Indicators (all on the chart symbol, no security calls) ─────────
float atr = ta.atr(atrLenIn)
[diP, diM, adx] = ta.dmi(adxLenIn, adxLenIn)
[bbMid, bbUp, bbLo] = ta.bb(close, bbLenIn, 2.0)
float bbwPct = bbMid != 0 ? (bbUp - bbLo) / bbMid * 100.0 : na
float ema = ta.ema(close, emaLenIn)

bool ranging   = not na(adx) and not na(bbwPct) and adx < adxMaxIn and bbwPct < bbwMaxIn
bool upTrend   = not na(ema) and close > ema
bool downTrend = not na(ema) and close < ema
bool regimeOk  = switch modeIn
    "Neutral" => not useRegimeIn or ranging
    "Long"    => upTrend and (not useRegimeIn or adx < adxMaxIn * 1.5)
    => downTrend and (not useRegimeIn or adx < adxMaxIn * 1.5)

// Candidate range from the PREVIOUS completed bars ([1]) so the current bar never defines its own range.
// All ta.* calls are made unconditionally every bar (calling them inside switch/if branches gives inconsistent history).
float emaR  = ta.ema(close, rangeLenIn)
float dHi   = ta.highest(high, rangeLenIn)
float dLo   = ta.lowest(low, rangeLenIn)
float pHi   = ta.percentile_linear_interpolation(close, rangeLenIn, pctHiIn)
float pLo   = ta.percentile_linear_interpolation(close, rangeLenIn, pctLoIn)
float hiC = rangeSrcIn == "ATR" ? emaR[1] + atr[1] * atrMultIn : rangeSrcIn == "Donchian" ? dHi[1] : pHi[1]
float loC = rangeSrcIn == "ATR" ? emaR[1] - atr[1] * atrMultIn : rangeSrcIn == "Donchian" ? dLo[1] : pLo[1]

f_level(int i, float lo, float hi, int n, string sp) =>
    float frac = i / (n - 1.0)          // float division (avoids int-division pitfall)
    sp == "Geometric" ? lo * math.pow(hi / lo, frac) : lo + (hi - lo) * frac

f_stepPct(float lo, float hi, int n, string sp) =>
    sp == "Geometric" ? (math.pow(hi / lo, 1.0 / (n - 1)) - 1.0) * 100.0 : (hi - lo) / (n - 1) / lo * 100.0

f_isOpen(string id) =>
    bool found = false
    if strategy.opentrades > 0
        for t = 0 to strategy.opentrades - 1
            if strategy.opentrades.entry_id(t) == id
                found := true
                break
    found

f_num(float v) => str.tostring(nz(v), format.mintick)

// Compact JSON. sym = syminfo.ticker for alert(); "{{ticker}}" for order alert_message (placeholders only expand there).
f_json(string action, string side, int lvl, float price, float qty, float stop, string sym) =>
    '{"secret":"' + secretIn + '","src":"gridv2","action":"' + action + '","mode":"' + str.lower(modeIn) +
     '","symbol":"' + sym + '","side":"' + side + '","price":' + f_num(price) + ',"level":' + str.tostring(lvl) +
     ',"qty":' + str.tostring(nz(qty), "#.########") + ',"stop":' + f_num(stop) + ',"ts":' + str.tostring(time_close) + '}'

// ───────── Grid state ─────────
var array<float> levels = array.new<float>()
var float gLo = na
var float gHi = na
var bool  gridOn = false
var int   cooldown = 0
var array<line> gLines = array.new<line>()

bool  built = false
bool  invalidated = false

if barstate.isconfirmed
    if cooldown > 0
        cooldown -= 1
    // 1) Invalidate an active grid on a CLOSE beyond the stop band, or when regime turns off with no open trades.
    if gridOn
        bool brk = close < gLo - atr * stopAtrIn or close > gHi + atr * stopAtrIn
        if brk or (not regimeOk and strategy.opentrades == 0)
            invalidated := true
            gridOn := false
            cooldown := cooldownIn
            if brk and strategy.position_size != 0
                strategy.close_all(comment = "Range break", alert_message = f_json("range_break", "flat", -1, close, math.abs(strategy.position_size), close, "{{ticker}}"))
                if alertsOnIn
                    alert(f_json("range_break", "flat", -1, close, math.abs(strategy.position_size), close, syminfo.ticker), alert.freq_once_per_bar_close)
    // 2) Build a new grid when flat-ish, regime allows, cooldown done, range valid and wide enough vs fees.
    if not gridOn and cooldown == 0 and regimeOk and not na(hiC) and not na(loC) and loC > 0 and hiC > loC and close > loC and close < hiC
        if f_stepPct(loC, hiC, gridCountIn, spacingIn) >= minStepPctIn
            gLo := loC
            gHi := hiC
            array.clear(levels)
            for i = 0 to gridCountIn - 1
                array.push(levels, f_level(i, gLo, gHi, gridCountIn, spacingIn))
            gridOn := true
            built := true
            if alertsOnIn
                alert('{"secret":"' + secretIn + '","src":"gridv2","action":"grid_build","mode":"' + str.lower(modeIn) + '","symbol":"' + syminfo.ticker + '","lo":' + f_num(gLo) + ',"hi":' + f_num(gHi) + ',"n":' + str.tostring(gridCountIn) + ',"ts":' + str.tostring(time_close) + '}', alert.freq_once_per_bar_close)

// 3) Level crossings on confirmed bars (skip the build bar to avoid acting on a just-created grid).
if barstate.isconfirmed and gridOn and not built and array.size(levels) == gridCountIn
    float mid = (gridCountIn - 1) / 2.0
    int openCount = strategy.opentrades   // local counter so several crossings in one bar cannot exceed the cap
    for i = 0 to gridCountIn - 1
        float lvl = array.get(levels, i)
        bool crossDn = close < lvl and close[1] >= lvl
        bool crossUp = close > lvl and close[1] <= lvl
        // Long legs: buy at level i (never the top line), target level i+1.
        bool longAllowed  = modeIn == "Long" or (modeIn == "Neutral" and i < mid)
        bool shortAllowed = modeIn == "Short" or (modeIn == "Neutral" and i > mid)
        if crossDn and longAllowed and i < gridCountIn - 1 and strategy.position_size >= 0 and openCount < maxOpenIn
            string id = "L" + str.tostring(i)
            if not f_isOpen(id)
                float q = strategy.equity * qtyPctIn / 100.0 / close
                float sl = gLo - atr * stopAtrIn
                openCount += 1
                strategy.entry(id, strategy.long, qty = q, comment = id, alert_message = f_json("entry", "buy", i, lvl, q, sl, "{{ticker}}"))
                if alertsOnIn
                    alert(f_json("entry", "buy", i, close, q, sl, syminfo.ticker), alert.freq_once_per_bar_close)
        if crossUp and shortAllowed and i > 0 and strategy.position_size <= 0 and openCount < maxOpenIn
            string id = "S" + str.tostring(i)
            if not f_isOpen(id)
                float q = strategy.equity * qtyPctIn / 100.0 / close
                float sl = gHi + atr * stopAtrIn
                openCount += 1
                strategy.entry(id, strategy.short, qty = q, comment = id, alert_message = f_json("entry", "sell", i, lvl, q, sl, "{{ticker}}"))
                if alertsOnIn
                    alert(f_json("entry", "sell", i, close, q, sl, syminfo.ticker), alert.freq_once_per_bar_close)

// 4) Exits: each open leg gets a limit at the adjacent level and a hard stop beyond the range (resting orders, intrabar).
if gridOn and array.size(levels) == gridCountIn
    for i = 0 to gridCountIn - 1
        if i < gridCountIn - 1
            string lid = "L" + str.tostring(i)
            if f_isOpen(lid)
                float tgt = array.get(levels, i + 1)
                strategy.exit("xL" + str.tostring(i), from_entry = lid, limit = tgt, stop = gLo - atr * stopAtrIn, comment_profit = "TP L" + str.tostring(i), comment_loss = "SL L" + str.tostring(i), alert_message = f_json("exit", "sell", i, tgt, na, gLo - atr * stopAtrIn, "{{ticker}}"))
        if i > 0
            string sid = "S" + str.tostring(i)
            if f_isOpen(sid)
                float tgt = array.get(levels, i - 1)
                strategy.exit("xS" + str.tostring(i), from_entry = sid, limit = tgt, stop = gHi + atr * stopAtrIn, comment_profit = "TP S" + str.tostring(i), comment_loss = "SL S" + str.tostring(i), alert_message = f_json("exit", "buy", i, tgt, na, gHi + atr * stopAtrIn, "{{ticker}}"))

// 5) Optional flatten at the opposite range edge (confirmed close).
if barstate.isconfirmed and tpEdgeIn and gridOn and not built
    bool longEdge  = strategy.position_size > 0 and close >= gHi
    bool shortEdge = strategy.position_size < 0 and close <= gLo
    if longEdge or shortEdge
        strategy.close_all(comment = "Edge TP", alert_message = f_json("edge_exit", "flat", -1, close, math.abs(strategy.position_size), na, "{{ticker}}"))
        if alertsOnIn
            alert(f_json("edge_exit", "flat", -1, close, math.abs(strategy.position_size), na, syminfo.ticker), alert.freq_once_per_bar_close)

// ───────── Display ─────────
if barstate.isconfirmed and (built or invalidated)
    while array.size(gLines) > 0
        line.delete(array.pop(gLines))
    if showLinesIn and gridOn
        for i = 0 to gridCountIn - 1
            float p = array.get(levels, i)
            color c = i == 0 or i == gridCountIn - 1 ? color.orange : color.new(color.gray, 30)
            array.push(gLines, line.new(bar_index, p, bar_index + 1, p, extend = extend.right, color = c, style = line.style_dotted))

plot(gridOn ? gHi : na, "Grid upper", color.new(color.red, 0), 1, plot.style_linebr)
plot(gridOn ? gLo : na, "Grid lower", color.new(color.green, 0), 1, plot.style_linebr)
plot(gridOn and modeIn != "Short" ? gLo - atr * stopAtrIn : na, "Long stop", color.new(color.red, 50), 1, plot.style_linebr)
plot(gridOn and modeIn != "Long" ? gHi + atr * stopAtrIn : na, "Short stop", color.new(color.red, 50), 1, plot.style_linebr)
plot(ema, "Trend EMA", color.new(color.blue, 40))
bgcolor(useRegimeIn and ranging ? color.new(color.teal, 92) : na, title = "Ranging regime")

var table tb = table.new(position.top_right, 2, 6, bgcolor = color.new(#1e293b, 0), border_width = 1)
if barstate.islast and showTableIn
    float stp = gridOn ? f_stepPct(gLo, gHi, gridCountIn, spacingIn) : na
    table.cell(tb, 0, 0, "Mode", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 0, modeIn + (gridOn ? " · ON" : " · OFF"), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 1, "Regime", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 1, ranging ? "Ranging" : upTrend ? "Trend up" : "Trend down", text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 2, "Range", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 2, gridOn ? f_num(gLo) + " – " + f_num(gHi) : "-", text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 3, "Step %", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 3, na(stp) ? "-" : str.tostring(stp, "#.##") + "%", text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 4, "Open legs", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 4, str.tostring(strategy.opentrades) + " / " + str.tostring(maxOpenIn), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 5, "ADX / BBW%", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 5, str.tostring(adx, "#.0") + " / " + str.tostring(bbwPct, "#.0"), text_color = color.white, text_size = size.small)
