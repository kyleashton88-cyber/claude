string srcTf   = input.timeframe("240", "Source timeframe (scoring data)", group = G_P, tooltip = "All metrics use completed bars of this timeframe. Chart must be on a LOWER timeframe (1h).")
int   rangeLen = input.int(100, "Range lookback (Donchian)", minval = 20, group = G_P)
int   histLen  = input.int(300, "History window for containment", minval = 50, group = G_P)
int   crossLen = input.int(100, "Midline-cross window", minval = 20, group = G_P)
float adxMax   = input.float(22.0, "ADX ranging max", group = G_P)
float bbwLo    = input.float(2.0, "BB width % sweet spot low", group = G_P)
float bbwHi    = input.float(8.0, "BB width % sweet spot high", group = G_P)
float atrLo    = input.float(0.4, "ATR % sweet spot low", group = G_P)
float atrHi    = input.float(1.8, "ATR % sweet spot high", group = G_P)
float minQVol  = input.float(2000000, "Min avg quote volume per hour, last 24h (USDT)", group = G_P, tooltip = "Average quote volume PER HOUR over the last 24h, measured on source-TF bars (24h / source-TF bars). 2M ≈ 48M per day – same meaning as the 1h version.")
float minScore = input.float(60, "Min grid-fit score to alert", minval = 0, maxval = 100, group = G_P)
int   topN     = input.int(15, "Rows in table", minval = 5, maxval = 40, group = G_P)
int   maxAlert = input.int(10, "Max symbols per alert payload", minval = 1, maxval = 20, group = G_A)
string secret  = input.string("CHANGE_ME", "Webhook secret (placeholder)", group = G_A)
// [MERGE-A] Volatility spike exclusion (same rule as the strategy)
float spikeRatio = input.float(1.8, "Spike: ATR(14)/SMA(ATR,100) above", minval = 1.0, step = 0.1, group = G_P)
float spikeRange = input.float(2.5, "Spike: bar range above x ATR", minval = 1.0, step = 0.1, group = G_P)
int   spikeCool  = input.int(6, "Spike cooldown bars", minval = 0, group = G_P)

f_band(float x, float lo, float hi) =>
    // 1 inside [lo, hi], fading linearly to 0 at half / double the band edges
    x >= lo and x <= hi ? 1.0 : x < lo ? math.max(0.0, x / lo * 2.0 - 1.0) : math.max(0.0, 1.0 - (x - hi) / hi)

// Evaluated inside each symbol's context by request.security. Returns values of the last CLOSED bar.
f_metrics() =>
    [dP, dM, adx] = ta.dmi(14, 14)
    [bm, bu, bl] = ta.bb(close, 20, 2.0)
    float bbw   = bm != 0 ? (bu - bl) / bm * 100.0 : na
    float atrP  = ta.atr(14) / close * 100.0
    float hi    = ta.highest(high, rangeLen)
    float lo    = ta.lowest(low, rangeLen)
    float ema   = ta.ema(close, 200)
    float midE  = ta.ema(close, 50)
    // Historical containment: share of bars whose close stayed inside the range that was known one window earlier.
    float inside = close <= hi[rangeLen] and close >= lo[rangeLen] ? 1.0 : 0.0
    float fit   = ta.sma(inside, histLen) * 100.0
    float xs    = math.sum(ta.cross(close, midE) ? 1.0 : 0.0, crossLen)
    // liquidity: average quote volume per HOUR over the last 24h, so the 1h-era threshold keeps its meaning
    int   bars24 = math.max(1, int(math.round(86400.0 / timeframe.in_seconds())))
    float qv    = math.sum(close * volume, bars24) / 24.0
    float sAdx  = math.max(0.0, math.min(1.0, (adxMax * 1.6 - adx) / (adxMax * 0.8)))
    float sBbw  = f_band(nz(bbw), bbwLo, bbwHi)
    float sAtr  = f_band(nz(atrP), atrLo, atrHi)
    float sX    = math.min(1.0, xs / 8.0)
    float sFit  = nz(fit) / 100.0
    float score = 100.0 * (0.25 * sAdx + 0.15 * sBbw + 0.15 * sAtr + 0.15 * sX + 0.30 * sFit)
    // [MERGE-A] spike within the last spikeCool+1 bars -> score = -2 (excluded, shown as "spike")
    float a14   = ta.atr(14)
    float aBase = ta.sma(a14, 100)
    float spk   = (aBase > 0 and a14 / aBase > spikeRatio) or (high - low) > spikeRange * a14 ? 1.0 : 0.0
    bool  spiking = ta.highest(spk, spikeCool + 1) > 0
    score := spiking ? -2.0 : score
    int   gm    = adx < adxMax and nz(bbw) < bbwHi ? 0 : close > ema ? 1 : -1   // 0 neutral, 1 long, -1 short
    [score[1], float(gm[1]), lo[1], hi[1], fit[1], adx[1], atrP[1], qv[1], close[1], float(time_close[1])]

var array<string> syms = array.from(s00, s01, s02, s03, s04, s05, s06, s07, s08, s09, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, s28, s29, s30, s31, s32, s33, s34, s35)
array<float> sc = array.new<float>()
array<float> md = array.new<float>()
array<float> los = array.new<float>()
array<float> his = array.new<float>()
array<float> fits = array.new<float>()
array<float> adxs = array.new<float>()
array<float> atrs = array.new<float>()
array<float> qvs = array.new<float>()

f_push(float score, float mode, float lo, float hi, float fit, float adx, float atrP, float qv, array<float> aSc, array<float> aMd, array<float> aLo, array<float> aHi, array<float> aFit, array<float> aAdx, array<float> aAtr, array<float> aQv) =>
    bool liquid = nz(qv) >= minQVol
    array.push(aSc, not liquid ? -1.0 : nz(score, -1.0))   // illiquid / no data = -1, spiking = -2 (both excluded)
    array.push(aMd, mode)
    array.push(aLo, lo)
    array.push(aHi, hi)
    array.push(aFit, fit)
    array.push(aAdx, adx)
    array.push(aAtr, atrP)
    array.push(aQv, qv)
    true

