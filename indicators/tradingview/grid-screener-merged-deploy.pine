array<int> rank = array.sort_indices(sc, order.descending)

f_modeStr(float m) => m == 0 ? "neutral" : m > 0 ? "long" : "short"

// Plot the chart symbol's own score for reference
[myScore, myMode, myLo, myHi, myFit, myAdx, myAtr, myQv, myC] = request.security(syminfo.tickerid, timeframe.period, f_metrics(), lookahead = barmerge.lookahead_off)
plot(myScore, "Grid-fit score (this chart)", color.teal, 2)
hline(60, "Alert threshold (default)", color.gray, hline.style_dotted)

var table t = table.new(position.top_right, 6, 41, bgcolor = color.new(#1e293b, 0), border_width = 1)
if barstate.islast
    table.cell(t, 0, 0, "Symbol", text_color = color.white, text_size = size.tiny)
    table.cell(t, 1, 0, "Grid-fit", text_color = color.white, text_size = size.tiny)
    table.cell(t, 2, 0, "Mode", text_color = color.white, text_size = size.tiny)
    table.cell(t, 3, 0, "Range lo – hi", text_color = color.white, text_size = size.tiny)
    table.cell(t, 4, 0, "Contain % (hist)", text_color = color.white, text_size = size.tiny)
    table.cell(t, 5, 0, "ADX / ATR%", text_color = color.white, text_size = size.tiny)
    int rows = math.min(topN, array.size(rank))
    for r = 0 to rows - 1
        int k = array.get(rank, r)
        float s = array.get(sc, k)
        color bg = s >= minScore ? color.new(color.teal, 40) : s < 0 ? color.new(color.gray, 60) : color.new(#1e293b, 0)
        table.cell(t, 0, r + 1, array.get(syms, k), text_color = color.white, bgcolor = bg, text_size = size.tiny)
        table.cell(t, 1, r + 1, s <= -2 ? "spike" : s < 0 ? "n/a" : str.tostring(s, "#"), text_color = color.white, bgcolor = bg, text_size = size.tiny)
        table.cell(t, 2, r + 1, f_modeStr(array.get(md, k)), text_color = color.white, bgcolor = bg, text_size = size.tiny)
        table.cell(t, 3, r + 1, str.tostring(array.get(los, k), "#.#####") + " – " + str.tostring(array.get(his, k), "#.#####"), text_color = color.white, bgcolor = bg, text_size = size.tiny)
        table.cell(t, 4, r + 1, str.tostring(array.get(fits, k), "#"), text_color = color.white, bgcolor = bg, text_size = size.tiny)
        table.cell(t, 5, r + 1, str.tostring(array.get(adxs, k), "#.0") + " / " + str.tostring(array.get(atrs, k), "#.00"), text_color = color.white, bgcolor = bg, text_size = size.tiny)

// One compact JSON per bar close listing qualifying symbols (best first, capped to keep payload small).
if barstate.isconfirmed
    string items = ""
    int n = 0
    for r = 0 to array.size(rank) - 1
        int k = array.get(rank, r)
        float s = array.get(sc, k)
        if s >= minScore and n < maxAlert
            items += (n > 0 ? "," : "") + '{"s":"' + array.get(syms, k) + '","m":"' + f_modeStr(array.get(md, k)) + '","lo":' + str.tostring(array.get(los, k), "#.########") + ',"hi":' + str.tostring(array.get(his, k), "#.########") + ',"fit":' + str.tostring(s, "#") + '}'
            n += 1
    if n > 0
        alert('{"secret":"' + secret + '","src":"screener","action":"screener","tf":"' + timeframe.period + '","ts":' + str.tostring(time_close) + ',"alert_id":"screener_' + timeframe.period + '_' + str.tostring(time) + '","symbols":[' + items + ']}', alert.freq_once_per_bar_close)
